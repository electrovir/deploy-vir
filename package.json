{
    "name": "deploy-vir",
    "version": "3.6.2",
    "description": "Deploy a branch to another branch with notifications.",
    "keywords": [
        "deploy",
        "devops",
        "pipeline"
    ],
    "homepage": "https://github.com/electrovir/deploy-vir",
    "bugs": {
        "url": "https://github.com/electrovir/deploy-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/deploy-vir.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": {
        "deploy-vir": "bin.js"
    },
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "virmator test node",
        "test:all": "npm run compile && runstorm --names spelling,format,docs,deps,lint,test \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\" \"npm test\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.5.0",
        "@augment-vir/common": "^32.5.0",
        "@augment-vir/node": "^32.5.0",
        "@inquirer/prompts": "^8.7.3",
        "@slack/web-api": "^8.2.0",
        "cli-vir": "^1.1.1",
        "simple-git": "^4.0.2",
        "tsx": "^4.23.15",
        "url-vir": "^2.2.2"
    },
    "devDependencies": {
        "@augment-vir/test": "^32.5.0",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^26.6.5",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "cspell": "^10.3.6",
        "dependency-cruiser": "^18.5.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.3.0",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.12.1",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^77.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.1.1",
        "npm-check-updates": "^23.1.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^3.0.2",
        "runstorm": "^1.1.0",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "virmator": "^14.38.0"
    },
    "engines": {
        "node": ">=22"
    }
}
