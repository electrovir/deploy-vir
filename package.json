{
    "name": "deploy-vir",
    "version": "0.0.2",
    "description": "Deploy a branch to another branch with notifications.",
    "keywords": [
        "deploy",
        "devops",
        "pipeline"
    ],
    "homepage": "https://github.com/electrovir/deploy-vir",
    "bugs": {
        "url": "https://github.com/electrovir/deploy-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/deploy-vir.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": "bin.js",
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names spelling,format,docs,deps,lint \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.28.0",
        "@augment-vir/common": "^31.28.0",
        "@augment-vir/node": "^31.28.0",
        "@slack/web-api": "^7.9.3",
        "simple-git": "^3.28.0",
        "tsx": "^4.20.3",
        "url-vir": "^2.1.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.32.0",
        "@stylistic/eslint-plugin": "^5.2.2",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^24.1.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "cspell": "^9.2.0",
        "dependency-cruiser": "^17.0.0",
        "esbuild": "^0.25.8",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^52.0.1",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.2.1",
        "eslint-plugin-prettier": "^5.5.3",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.4",
        "eslint-plugin-unicorn": "^57.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^18.0.2",
        "prettier": "^3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.3.3",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-organize-imports": "^4.2.0",
        "prettier-plugin-packagejson": "^2.5.19",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.6",
        "typedoc": "^0.28.8",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.38.0",
        "virmator": "^13.15.6"
    },
    "engines": {
        "node": ">=22"
    }
}
